# Copy to .env and edit locally. Never commit real credentials.
# Development: use a dedicated Jira project and a personal API token without scopes.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=replace-with-your-development-api-token
JIRA_PROJECT_KEY=TEST

# Required for REST. Generate a random value locally; use at least 32 random bytes.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(32))"
HALO_API_KEY=replace-with-a-locally-generated-random-key
HALO_TIMEOUT_SECONDS=15
HALO_WORKFLOW_DB=work/workflows.sqlite3
# Leave false for real Jira. The automated demo manages its own separate settings.
HALO_DEMO=false
